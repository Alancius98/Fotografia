---
import { Image } from 'astro:assets';
import { photos } from '../data/photos';

const selectedIds = ['1', '2', '3'];
const selectedPhotos = photos.filter((photo) => selectedIds.includes(photo.id));
---

<section class="bg-[#121212] px-4 py-28 md:py-32">
  <div class="mx-auto max-w-lg">
    <h2 class="reveal mb-12 text-center text-[11px] font-light tracking-[0.35em] text-white/70">
      TRABAJOS SELECCIONADOS
    </h2>

    <div class="flex flex-col gap-4">
      {
        selectedPhotos.map(
          (photo, index) =>
            photo && (
              <a
                href="/portafolio"
                class={`reveal hover-image group relative aspect-[4/3] overflow-hidden bg-[#181818] ${index % 2 === 1 ? 'reveal-delay-2' : ''}`}
              >
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  width={1152}
                  height={864}
                  fit="cover"
                  format="avif"
                  quality={90}
                  class="h-full w-full object-cover"
                />
                <div class="absolute inset-0 bg-black/0 transition-colors duration-500 group-hover:bg-black/30" />
                <div class="absolute inset-0 flex flex-col items-center justify-center opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                  <p class="text-[10px] font-light tracking-[0.3em] text-white/80">{photo.category}</p>
                  <p class="font-serif mt-2 text-xl italic text-white">{photo.title}</p>
                </div>
              </a>
            )
        )
      }
    </div>

    <div class="reveal mt-12 flex justify-center">
      <a href="/portafolio" class="btn-editorial w-full justify-center sm:w-auto">VER PORTAFOLIO</a>
    </div>
  </div>
</section>