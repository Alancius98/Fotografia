---
const currentYear = new Date().getFullYear();

const navItems = [
  { label: 'HOME', href: '/' },
  { label: 'ABOUT', href: '/sobre-mi' },
  { label: 'SERVICES', href: '/portafolio' },
  { label: 'PORTFOLIO', href: '/portafolio' },
  { label: 'TESTIMONIALS', href: '/#testimonials' },
  { label: 'CONTACT', href: '/contacto' }
];

const currentPath = Astro.url.pathname;
---

<footer class="border-t border-white/5 bg-[#121212] py-16">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col items-center gap-8">
      <!-- Iconos sociales -->
      <div class="flex items-center gap-6">
        <a
          href="https://www.facebook.com/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="text-white/40 transition-colors hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
        <a
          href="https://x.com/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X"
          class="text-white/40 transition-colors hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4l11.733 16h4.267l-11.733 -16z"/>
            <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/>
          </svg>
        </a>
        <a
          href="https://www.instagram.com/alancius.1998/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-white/40 transition-colors hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
          </svg>
        </a>
      </div>

      <!-- Menú inferior -->
      <nav class="flex flex-wrap justify-center gap-6 md:gap-10">
        {
          navItems.map((item) => {
            const isActive = currentPath === item.href;
            return (
              <a
                href={item.href}
                class={`text-[10px] font-light tracking-[0.2em] transition-colors ${
                  isActive ? 'text-white' : 'text-white/50 hover:text-white'
                }`}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <p class="text-[10px] font-light tracking-[0.15em] text-white/40">
        © {currentYear} ALANCIUS. ALL RIGHTS RESERVED.
      </p>
    </div>
  </div>
</footer>
