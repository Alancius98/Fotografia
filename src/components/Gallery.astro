---
import { photos, categories } from '../data/photos';

interface Props {
  showFilters?: boolean;
  limit?: number;
}

const { showFilters = true, limit } = Astro.props;
const displayPhotos = limit ? photos.slice(0, limit) : photos;
---

<section
  class="gallery mx-auto max-w-7xl px-6 py-16"
  data-photos={JSON.stringify(displayPhotos)}
>
  {
    showFilters && (
      <div class="mb-10 flex flex-wrap justify-center gap-3">
        {categories.map((category) => (
          <button
            type="button"
            data-filter={category}
            class={`filter-btn rounded-full border px-5 py-2 text-sm font-light tracking-wide transition-all ${
              category === 'Todos'
                ? 'border-white/30 bg-white/10 text-white'
                : 'border-white/10 text-text-muted hover:border-white/30 hover:text-white'
            }`}
          >
            {category}
          </button>
        ))}
      </div>
    )
  }

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {
      displayPhotos.map((photo, index) => {
        const isPriority = index < 4;
        return (
          <button
            type="button"
            class="gallery-item group relative aspect-[3/4] cursor-pointer overflow-hidden rounded-sm bg-surface"
            data-category={photo.category}
            data-id={photo.id}
            aria-label={`Ver ${photo.title}`}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              loading={isPriority ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={isPriority ? 'high' : 'low'}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-black/0 transition-colors duration-500 group-hover:bg-black/30" />
            <div class="absolute inset-x-0 bottom-0 translate-y-full p-4 transition-transform duration-500 group-hover:translate-y-0">
              <p class="text-sm font-medium text-white">{photo.title}</p>
              <p class="text-xs font-light uppercase tracking-wider text-white/80">{photo.category}</p>
            </div>
          </button>
        );
      })
    }
  </div>

  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Vista ampliada"
  >
    <button
      type="button"
      id="lightbox-close"
      class="absolute right-6 top-6 z-10 text-white/70 transition-colors hover:text-white"
      aria-label="Cerrar"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18"/>
        <path d="m6 6 12 12"/>
      </svg>
    </button>

    <button
      type="button"
      id="lightbox-prev"
      class="absolute left-4 top-1/2 z-10 -translate-y-1/2 text-white/70 transition-colors hover:text-white md:left-8"
      aria-label="Anterior"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"/>
      </svg>
    </button>

    <button
      type="button"
      id="lightbox-next"
      class="absolute right-4 top-1/2 z-10 -translate-y-1/2 text-white/70 transition-colors hover:text-white md:right-8"
      aria-label="Siguiente"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6"/>
      </svg>
    </button>

    <figure class="flex max-h-screen w-full max-w-[95vw] flex-col items-center justify-center p-4 md:max-w-[90vw]">
      <img
        id="lightbox-image"
        src=""
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="h-auto w-auto max-h-[85vh] max-w-full object-contain"
        style="image-rendering: auto;"
      />
      <figcaption class="mt-4 text-center">
        <p id="lightbox-title" class="text-lg font-medium text-white"></p>
        <p id="lightbox-category" class="text-xs font-light uppercase tracking-wider text-text-muted"></p>
      </figcaption>
    </figure>
  </div>
</section>

<script>
(function () {
  const gallery = document.querySelector('.gallery') as HTMLElement | null;
  if (!gallery) return;

  const photos = JSON.parse(gallery.dataset.photos || '[]');
  const items = Array.from(gallery.querySelectorAll('.gallery-item')) as HTMLElement[];
  const filterButtons = gallery.querySelectorAll('.filter-btn');

  const lightbox = document.getElementById('lightbox') as HTMLElement | null;
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const lightboxTitle = document.getElementById('lightbox-title') as HTMLElement | null;
  const lightboxCategory = document.getElementById('lightbox-category') as HTMLElement | null;

  let currentIndex = 0;
  let visiblePhotos = [...photos];

  function updateVisibleItems() {
    const activeBtn = gallery.querySelector('.filter-btn[data-active="true"]') as HTMLElement | null;
    const filter = activeBtn?.dataset.filter || 'Todos';

    visiblePhotos = filter === 'Todos'
      ? [...photos]
      : photos.filter((p: any) => p.category === filter);

    items.forEach((item) => {
      const category = item.dataset.category;
      if (filter === 'Todos' || category === filter) {
        item.classList.remove('hidden');
        item.classList.add('block');
      } else {
        item.classList.add('hidden');
        item.classList.remove('block');
      }
    });
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.removeAttribute('data-active');
        b.classList.remove('border-white/30', 'bg-white/10', 'text-white');
        b.classList.add('border-white/10', 'text-text-muted');
      });

      btn.setAttribute('data-active', 'true');
      btn.classList.remove('border-white/10', 'text-text-muted');
      btn.classList.add('border-white/30', 'bg-white/10', 'text-white');

      updateVisibleItems();
    });
  });

  function openLightbox(photo: any, index: number) {
    if (!lightbox || !lightboxImage || !lightboxTitle || !lightboxCategory) return;

    currentIndex = index;
    lightboxImage.src = photo.src;
    lightboxImage.alt = photo.alt;
    lightboxTitle.textContent = photo.title;
    lightboxCategory.textContent = photo.category;

    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function showPhotoAtIndex(index: number) {
    if (visiblePhotos.length === 0) return;
    currentIndex = (index + visiblePhotos.length) % visiblePhotos.length;
    const photo = visiblePhotos[currentIndex];
    if (lightboxImage) lightboxImage.src = photo.src;
    if (lightboxImage) lightboxImage.alt = photo.alt;
    if (lightboxTitle) lightboxTitle.textContent = photo.title;
    if (lightboxCategory) lightboxCategory.textContent = photo.category;
  }

  items.forEach((item) => {
    item.addEventListener('click', () => {
      const id = item.dataset.id;
      const photo = visiblePhotos.find((p: any) => p.id === id) || photos.find((p: any) => p.id === id);
      if (photo) {
        updateVisibleItems();
        const index = visiblePhotos.findIndex((p: any) => p.id === photo.id);
        openLightbox(photo, index >= 0 ? index : 0);
      }
    });
  });

  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')?.addEventListener('click', (e) => {
    e.stopPropagation();
    showPhotoAtIndex(currentIndex - 1);
  });
  document.getElementById('lightbox-next')?.addEventListener('click', (e) => {
    e.stopPropagation();
    showPhotoAtIndex(currentIndex + 1);
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showPhotoAtIndex(currentIndex - 1);
    if (e.key === 'ArrowRight') showPhotoAtIndex(currentIndex + 1);
  });

  updateVisibleItems();
})();
</script>
