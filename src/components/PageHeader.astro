---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
}

const { title, subtitle, image } = Astro.props;
---

<section class={`relative flex items-center justify-center overflow-hidden py-24 ${image ? 'min-h-[40vh]' : 'bg-[#121212]'}`}>
  {
    image && (
      <>
        <Image
          src={image}
          alt=""
          priority
          layout="full-width"
          format="avif"
          quality={80}
          widths={[720, 1080, 1440, 1920]}
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-black/40"></div>
      </>
    )
  }

  <div class="relative z-10 px-4 text-center">
    <h1 class="font-display text-3xl text-white">
      {title}
    </h1>
    {
      subtitle && (
        <p class="font-serif mt-4 text-base font-light italic tracking-wide text-white/80">
          {subtitle}
        </p>
      )
    }
  </div>
</section>