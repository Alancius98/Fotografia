---
interface Props {
  title?: string;
  subtitle?: string;
  image?: string;
}

const {
  title = 'ALANCIUS',
  subtitle = 'MODERN PORTRAIT & WEDDING PHOTOGRAPHY',
  image = '/images/hero.jpg'
} = Astro.props;
---

<section class="hero-section relative flex h-screen w-full items-center justify-center overflow-hidden">
  <img
    src={image}
    alt="Hero editorial photography"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="hero-image absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-black/30"></div>

  <div class="relative z-10 px-6 text-center">
    <h1 class="font-display text-6xl text-white md:text-8xl lg:text-9xl">
      {title}
    </h1>
    <p class="font-serif mt-8 text-lg font-light italic tracking-wide text-white/90 md:text-2xl">
      {subtitle}
    </p>
  </div>

  <script>
    (function () {
      const section = document.querySelector('.hero-section');
      const image = document.querySelector('.hero-image');
      if (!section || !image) return;

      window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        const rate = scrolled * 0.35;
        (image as HTMLElement).style.transform = `translateY(${rate}px) scale(1.05)`;
      });
    })();
  </script>
</section>
