---
interface Props {
  title?: string;
  subtitle?: string;
  image?: string;
}

const {
  title = 'ALANCIUS',
  subtitle = 'MODERN PORTRAIT & WEDDING PHOTOGRAPHY',
  image = '/images/hero.jpg'
} = Astro.props;
---

<section class="relative flex h-screen w-full items-center justify-center overflow-hidden">
  <img
    src={image}
    alt="Hero editorial photography"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-black/30"></div>

  <div class="relative z-10 text-center px-6">
    <h1 class="text-5xl font-extralight tracking-[0.35em] text-white md:text-7xl lg:text-8xl">
      {title}
    </h1>
    <p class="font-serif mt-8 text-lg font-light italic tracking-wide text-white/90 md:text-2xl">
      {subtitle}
    </p>
  </div>
</section>
