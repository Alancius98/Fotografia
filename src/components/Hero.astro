---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroImage from '../assets/images/hero-main.jpg';

interface Props {
  title?: string;
  subtitle?: string;
  image?: ImageMetadata;
}

const {
  title = 'ALANCIUS',
  subtitle = 'FOTOGRAFÍA EDITORIAL Y DE BODAS',
  image = heroImage
} = Astro.props;
---

<section class="hero-section relative flex h-screen w-full items-center justify-center overflow-hidden">
  <Image
    src={image}
    alt=""
    priority
    layout="full-width"
    format="avif"
    quality={80}
    widths={[1080, 1440, 1920]}
    class="hero-image absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-black/30"></div>

  <div class="relative z-10 px-4 text-center">
    <h1 class="font-display text-5xl text-white">
      {title}
    </h1>
    <p class="font-serif mt-6 text-base font-light italic tracking-wide text-white/90">
      {subtitle}
    </p>
  </div>

  <script>
    (function () {
      const section = document.querySelector('.hero-section');
      const image = document.querySelector('.hero-image');
      if (!section || !image) return;

      window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        const rate = scrolled * 0.35;
        (image as HTMLElement).style.transform = `translateY(${rate}px) scale(1.05)`;
      });
    })();
  </script>
</section>