---
interface Props {
  image?: string;
}

const { image = '/images/banner.jpg' } = Astro.props;
---

<section class="relative flex min-h-[60vh] items-center overflow-hidden md:min-h-[70vh]">
  <img
    src={image}
    alt="Let's connect"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-black/40"></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-6">
    <div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
      <div class="reveal max-w-xl">
        <h2 class="font-display text-4xl text-white md:text-6xl">
          CONECTEMOS
        </h2>
        <p class="font-serif mt-6 text-base font-light italic leading-relaxed text-white/90 md:text-lg">
          Me encantaría escuchar tu historia y crear algo atemporal juntos.
        </p>
      </div>

      <div class="reveal reveal-delay-2">
        <a href="/contacto" class="btn-editorial">CONTÁCTAME</a>
      </div>
    </div>
  </div>
</section>
