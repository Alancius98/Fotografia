---
interface Props {
  image?: string;
}

const { image = '/images/banner.jpg' } = Astro.props;
---

<section class="relative flex min-h-[60vh] items-center overflow-hidden md:min-h-[70vh]">
  <img
    src={image}
    alt="Let's connect"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-black/40"></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-6">
    <div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
      <div class="max-w-xl">
        <h2 class="text-4xl font-extralight tracking-[0.25em] text-white md:text-6xl">
          LET'S CONNECT
        </h2>
        <p class="font-serif mt-6 text-base font-light italic leading-relaxed text-white/90 md:text-lg">
          I would love to hear about your story and create something timeless together.
        </p>
      </div>

      <a
        href="/contacto"
        class="inline-block border border-white bg-white px-10 py-4 text-[11px] font-normal tracking-[0.25em] text-[#121212] transition-colors hover:bg-transparent hover:text-white"
      >
        GET IN TOUCH
      </a>
    </div>
  </div>
</section>
