---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import bannerImage from '../assets/images/banner.jpg';

interface Props {
  image?: ImageMetadata;
}

const { image = bannerImage } = Astro.props;
---

<section class="relative flex min-h-[50vh] items-center overflow-hidden">
  <Image
    src={image}
    alt=""
    layout="full-width"
    format="avif"
    quality={80}
    widths={[720, 1080, 1440, 1920]}
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-black/40"></div>

  <div class="relative z-10 mx-auto w-full max-w-lg px-4">
    <div class="flex flex-col items-start gap-8">
      <div class="reveal">
        <h2 class="font-display text-3xl text-white">
          CONECTEMOS
        </h2>
        <p class="font-serif mt-5 text-base font-light italic leading-relaxed text-white/90">
          Me encantaría escuchar tu historia y crear algo atemporal juntos.
        </p>
      </div>

      <div class="reveal reveal-delay-2 w-full sm:w-auto">
        <a href="/contacto" class="btn-editorial w-full justify-center sm:w-auto">CONTÁCTAME</a>
      </div>
    </div>
  </div>
</section>