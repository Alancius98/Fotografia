---
const services = [
  {
    title: 'BODAS',
    description: 'Cobertura completa de tu día más importante, desde los preparativos hasta el último baile, con un enfoque editorial y atemporal.',
    features: ['8+ horas de cobertura', 'Dos fotógrafos', 'Galería en línea', 'Imágenes editadas en alta resolución'],
    price: 'DESDE $50,000 MXN',
    image: '/images/editorial-2.jpg'
  },
  {
    title: 'RETRATOS',
    description: 'Sesiones íntimas pensadas para capturar tu esencia con luz natural, composición elegante y emoción auténtica.',
    features: ['Sesión de 1–2 horas', 'Asesoría de vestuario', 'Scouting de locación', '20+ imágenes editadas'],
    price: 'DESDE $9,000 MXN',
    image: '/images/retrato.jpg'
  },
  {
    title: 'EDITORIAL',
    description: 'Campañas visuales para marcas, revistas y proyectos creativos que requieren una narrativa refinada y dirección de arte.',
    features: ['Dirección creativa', 'Estudio o locación', 'Derechos de uso', 'Entrega ágil'],
    price: 'COTIZACIÓN PERSONALIZADA',
    image: '/images/editorial-1.jpg'
  }
];
---

<section id="services" class="bg-[#121212] px-4 py-20">
  <div class="mx-auto max-w-lg">
    <div class="reveal mb-12 text-center">
      <h2 class="text-[11px] font-light tracking-[0.35em] text-white/70">
        SERVICIOS
      </h2>
      <p class="font-serif mt-4 text-lg font-light italic text-white/80">
        Experiencias personalizadas para cada historia
      </p>
    </div>

    <div class="flex flex-col gap-4 md:grid md:grid-cols-3 md:gap-6">
      {
        services.map((service, index) => (
          <div class={`reveal group border border-white/10 bg-[#181818] transition-colors duration-500 hover:border-white/30 ${index === 1 ? 'reveal-delay-2' : ''} ${index === 2 ? 'reveal-delay-3' : ''}`}>
            <div class="hover-image aspect-[4/3] overflow-hidden">
              <img
                src={service.image}
                alt={service.title}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="p-8">
              <h3 class="text-xs font-light tracking-[0.25em] text-white">{service.title}</h3>
              <p class="font-serif mt-4 text-base italic leading-relaxed text-white/70">
                {service.description}
              </p>
              <ul class="mt-6 space-y-2">
                {service.features.map((feature) => (
                  <li class="text-[10px] font-light tracking-[0.15em] text-white/50">• {feature}</li>
                ))}
              </ul>
              <p class="mt-8 text-[11px] font-light tracking-[0.25em] text-white/80">{service.price}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-12 text-center">
      <a href="/contacto" class="btn-outline w-full justify-center sm:w-auto">CONSULTAR DISPONIBILIDAD</a>
    </div>
  </div>
</section>
