---
const testimonials = [
  {
    quote: 'Alancius capturó cada emoción de nuestro día de boda con una elegancia increíble. Las fotos parecen páginas de una editorial de moda.',
    names: 'RAQUEL + JAIME'
  },
  {
    quote: 'Una sesión absolutamente atemporal. Cada imagen es refinada, emotiva y bellamente natural. No podríamos estar más felices.',
    names: 'EMMA + MIGUEL'
  },
  {
    quote: 'La atención a la luz y al detalle es incomparable. Nuestros retratos parecen sacados de una revista de lujo.',
    names: 'SOFÍA + DAVID'
  }
];
---

<section id="testimonials" class="bg-[#1e1e1e] px-6 py-24 md:py-32">
  <div class="mx-auto max-w-7xl">
    <h2 class="reveal mb-16 text-[11px] font-light tracking-[0.35em] text-white/70 md:text-xs">
      TESTIMONIOS
    </h2>

    <div class="grid gap-10 md:grid-cols-3 md:gap-12">
      {
        testimonials.map((item, index) => (
          <div class={`reveal text-center md:text-left ${index === 1 ? 'reveal-delay-2' : ''} ${index === 2 ? 'reveal-delay-3' : ''}`}>
            <p class="font-serif text-lg font-light italic leading-relaxed text-white/90 md:text-xl">
              "{item.quote}"
            </p>
            <p class="mt-6 text-[10px] font-light tracking-[0.25em] text-white/50">
              {item.names}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
