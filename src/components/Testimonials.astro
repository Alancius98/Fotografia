---
const testimonials = [
  {
    quote: 'Alancius captured every emotion of our wedding day with such elegance. The photos feel like pages from a fashion editorial.',
    names: 'RACHEL + JAMES'
  },
  {
    quote: 'An absolutely timeless session. Every image is refined, emotional, and effortlessly beautiful. We could not be happier.',
    names: 'EMMA + MICHAEL'
  },
  {
    quote: 'The attention to light and detail is unmatched. Our portraits look like they belong in a luxury magazine.',
    names: 'SOPHIA + DAVID'
  }
];
---

<section id="testimonials" class="bg-[#1e1e1e] px-6 py-24 md:py-32">
  <div class="mx-auto max-w-7xl">
    <h2 class="mb-16 text-[11px] font-light tracking-[0.35em] text-white/70 md:text-xs">
      TESTIMONIALS
    </h2>

    <div class="grid gap-10 md:grid-cols-3 md:gap-12">
      {
        testimonials.map((item) => (
          <div class="text-center md:text-left">
            <p class="font-serif text-lg font-light italic leading-relaxed text-white/90 md:text-xl">
              "{item.quote}"
            </p>
            <p class="mt-6 text-[10px] font-light tracking-[0.25em] text-white/50">
              {item.names}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
