---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Gallery from '../components/Gallery.astro';
---

<BaseLayout
  title="Portafolio"
  description="Portafolio de fotografía editorial, retratos y bodas de Alancius."
  solidNavbar={true}
>
  <PageHeader
    title="PORTFOLIO"
    subtitle="Una colección curada de retratos, bodas y trabajo editorial"
    image="/images/banner.jpg"
  />

  <div class="reveal">
    <Gallery showFilters={true} />
  </div>
</BaseLayout>
