---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout
  title="About"
  description="Meet Alancius — editorial portrait and wedding photographer."
  solidNavbar={true}
>
  <PageHeader
    title="ABOUT"
    subtitle="The story behind the lens"
    image="/images/hero.jpg"
  />

  <section class="mx-auto max-w-5xl px-6 py-24 md:py-32">
    <div class="grid gap-16 md:grid-cols-2 md:items-center">
      <div class="reveal hover-image aspect-[4/5] overflow-hidden bg-[#181818]">
        <img
          src="/images/photo-1.jpg"
          alt="Alancius photographer"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>

      <div class="space-y-8">
        <h2 class="reveal text-xs font-light tracking-[0.35em] text-white/60">
          EDITORIAL & WEDDING PHOTOGRAPHER
        </h2>
        <p class="reveal reveal-delay-1 font-serif text-2xl font-light italic leading-relaxed text-white md:text-3xl">
          "Less pose, more essence. Every frame should feel honest, elegant and timeless."
        </p>
        <p class="reveal reveal-delay-2 font-light leading-relaxed text-white/70">
          For over eight years I have been capturing portraits, weddings and commercial campaigns.
          My work seeks honesty in every image: the right light, the real expression, the detail
          that tells the story.
        </p>
        <p class="reveal reveal-delay-2 font-light leading-relaxed text-white/70">
          I collaborate with brands, agencies and people who value visual quality and a clear
          narrative. Every project begins by listening to what you want to tell.
        </p>

        <div class="reveal reveal-delay-3 grid grid-cols-3 gap-6 border-t border-white/10 pt-10">
          <div>
            <p class="text-3xl font-extralight tracking-wide text-white">8+</p>
            <p class="mt-1 text-[10px] font-light uppercase tracking-[0.2em] text-white/50">Years</p>
          </div>
          <div>
            <p class="text-3xl font-extralight tracking-wide text-white">120+</p>
            <p class="mt-1 text-[10px] font-light uppercase tracking-[0.2em] text-white/50">Projects</p>
          </div>
          <div>
            <p class="text-3xl font-extralight tracking-wide text-white">40+</p>
            <p class="mt-1 text-[10px] font-light uppercase tracking-[0.2em] text-white/50">Brands</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
