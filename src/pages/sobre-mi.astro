---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import heroImage from '../assets/images/hero.jpg';
import arquitecturaImage from '../assets/images/arquitectura.jpg';
---

<BaseLayout
  title="Sobre Mí"
  description="Conoce a Alancius — fotógrafo editorial, retratos y bodas."
  solidNavbar={true}
>
  <PageHeader
    title="SOBRE MÍ"
    subtitle="La historia detrás del lente"
    image={heroImage}
  />

  <section class="mx-auto max-w-lg px-4 py-20">
    <div class="flex flex-col gap-10 md:grid md:grid-cols-2 md:items-center md:gap-16">
      <div class="reveal hover-image aspect-[4/5] overflow-hidden bg-[#181818]">
        <Image
          src={arquitecturaImage}
          alt="Alancius fotógrafo"
          width={560}
          height={700}
          fit="cover"
          format="avif"
          quality={90}
          class="h-full w-full object-cover"
        />
      </div>

      <div class="space-y-6">
        <h2 class="reveal text-[11px] font-light tracking-[0.35em] text-white/60">
          FOTÓGRAFO EDITORIAL Y DE BODAS
        </h2>
        <p class="reveal reveal-delay-1 font-serif text-xl font-light italic leading-relaxed text-white">
          "Menos pose, más esencia. Cada fotograma debe sentirse honesto, elegante y atemporal."
        </p>
        <p class="reveal reveal-delay-2 text-sm font-light leading-relaxed text-white/70">
          Desde hace más de ocho años capturo retratos, bodas y campañas comerciales.
          Mi trabajo busca la honestidad en cada imagen: la luz justa, la expresión real, el detalle
          que cuenta la historia.
        </p>
        <p class="reveal reveal-delay-2 text-sm font-light leading-relaxed text-white/70">
          Colaboro con marcas, agencias y personas que valoran la calidad visual y una narrativa clara.
          Cada proyecto comienza escuchando lo que quieres contar.
        </p>

        <div class="reveal reveal-delay-3 grid grid-cols-3 gap-4 border-t border-white/10 pt-8">
          <div>
            <p class="text-2xl font-extralight tracking-wide text-white">8+</p>
            <p class="mt-1 text-[10px] font-light uppercase tracking-[0.2em] text-white/50">Años</p>
          </div>
          <div>
            <p class="text-2xl font-extralight tracking-wide text-white">120+</p>
            <p class="mt-1 text-[10px] font-light uppercase tracking-[0.2em] text-white/50">Proyectos</p>
          </div>
          <div>
            <p class="text-2xl font-extralight tracking-wide text-white">40+</p>
            <p class="mt-1 text-[10px] font-light uppercase tracking-[0.2em] text-white/50">Marcas</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
