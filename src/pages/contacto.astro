---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Alancius for portrait sessions, weddings and editorial projects."
  solidNavbar={true}
>
  <PageHeader
    title="CONTACT"
    subtitle="Let's create something timeless together"
    image="/images/hero.jpg"
  />

  <section class="mx-auto max-w-5xl px-6 py-24 md:py-32">
    <div class="grid gap-16 md:grid-cols-2">
      <div class="space-y-10">
        <div class="reveal">
          <h2 class="mb-4 text-xs font-light tracking-[0.35em] text-white/60">GET IN TOUCH</h2>
          <p class="font-serif text-2xl font-light italic leading-relaxed text-white md:text-3xl">
            I reply within 24 hours. Write me directly on WhatsApp or Instagram.
          </p>
        </div>

        <div class="space-y-4">
          <a
            href="https://wa.me/522216001248"
            target="_blank"
            rel="noopener noreferrer"
            class="reveal reveal-delay-1 group flex items-center gap-5 border border-white/10 bg-[#181818] p-5 transition-colors hover:border-white/30"
          >
            <span class="flex h-12 w-12 items-center justify-center bg-white/5 text-white transition-colors group-hover:bg-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </span>
            <div>
              <p class="text-[10px] font-light tracking-[0.2em] text-white/50">WHATSAPP</p>
              <p class="mt-1 text-sm font-light tracking-wide text-white">+52 221 600 1248</p>
            </div>
          </a>

          <a
            href="https://www.instagram.com/alancius.1998/"
            target="_blank"
            rel="noopener noreferrer"
            class="reveal reveal-delay-2 group flex items-center gap-5 border border-white/10 bg-[#181818] p-5 transition-colors hover:border-white/30"
          >
            <span class="flex h-12 w-12 items-center justify-center bg-white/5 text-white transition-colors group-hover:bg-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
              </svg>
            </span>
            <div>
              <p class="text-[10px] font-light tracking-[0.2em] text-white/50">INSTAGRAM</p>
              <p class="mt-1 text-sm font-light tracking-wide text-white">@alancius.1998</p>
            </div>
          </a>
        </div>
      </div>

      <form
        class="reveal reveal-delay-2 space-y-6 border border-white/10 bg-[#181818] p-8 md:p-10"
        action="https://formspree.io/f/TU_FORM_ID"
        method="POST"
      >
        <div>
          <label for="name" class="mb-2 block text-[10px] font-light tracking-[0.2em] text-white/50">NAME</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full border border-white/10 bg-[#121212] px-4 py-3 text-sm font-light text-white placeholder-white/20 outline-none transition-colors focus:border-white/30"
            placeholder="Your name"
          />
        </div>

        <div>
          <label for="email" class="mb-2 block text-[10px] font-light tracking-[0.2em] text-white/50">EMAIL</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full border border-white/10 bg-[#121212] px-4 py-3 text-sm font-light text-white placeholder-white/20 outline-none transition-colors focus:border-white/30"
            placeholder="your@email.com"
          />
        </div>

        <div>
          <label for="type" class="mb-2 block text-[10px] font-light tracking-[0.2em] text-white/50">PROJECT TYPE</label>
          <select
            id="type"
            name="type"
            class="w-full border border-white/10 bg-[#121212] px-4 py-3 text-sm font-light text-white outline-none transition-colors focus:border-white/30"
          >
            <option value="wedding">Wedding</option>
            <option value="portrait">Portrait</option>
            <option value="editorial">Editorial</option>
            <option value="commercial">Commercial</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div>
          <label for="message" class="mb-2 block text-[10px] font-light tracking-[0.2em] text-white/50">MESSAGE</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full resize-none border border-white/10 bg-[#121212] px-4 py-3 text-sm font-light text-white placeholder-white/20 outline-none transition-colors focus:border-white/30"
            placeholder="Tell me about your project..."
          ></textarea>
        </div>

        <div class="reveal reveal-delay-3">
          <button
            type="submit"
            class="btn-editorial w-full justify-center"
          >
            SEND MESSAGE
          </button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>
